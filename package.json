    "seed": "node --env-file-if-exists=.env server/seed.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "vite": "^6.3.5"
  }
}
