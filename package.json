{
  "name": "aicte-approval-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AICTE Approval Workflow Automation, Compliance Monitoring and Alert Management System (SIH prototype)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
