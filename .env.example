# Copy this file to .env and fill in the values from your Supabase project.
# Never commit .env: it contains your secret key. No spaces after "=".

# Project Settings -> API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The service_role key (or the newer "secret" key, sb_secret_...). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Project -> Connect -> "Session pooler" connection string (works on IPv4).
# Replace [YOUR-PASSWORD] with your database password, without the square brackets.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Same project URL, plus the public anon key (or the newer "publishable" key, sb_publishable_...).
# These are built into the browser bundle, so only ever put the public key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Email notifications (optional). Any SMTP provider works. For Gmail: turn on 2-step verification,
# create an App Password at myaccount.google.com/apppasswords, and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AICTE Approvals <your.address@gmail.com>
# Public address of the site, used for links in emails (defaults to the Vercel production URL).
APP_URL=

PORT=4000
